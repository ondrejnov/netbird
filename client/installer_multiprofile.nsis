; Installer of the multi-profile fork: the CLI daemon with Wintun, no UI.
; Built by release_files/multiprofile/windows-installer.sh, which passes the
; defines below.

Unicode True
ManifestDPIAware true
RequestExecutionLevel admin

!ifndef ARCH | VERSION | DISPLAY_VERSION | SRC_DIR | ROOT_DIR | OUT_FILE
    !error "build with release_files/multiprofile/windows-installer.sh"
!endif

; The name and registry keys match the upstream installer, so installing one
; removes the other: both own the netbird service and netbird.exe.
!define APP_NAME "Netbird"
!define DISPLAY_NAME "NetBird multiprofile"
!define PUBLISHER "NetBird fork (ondrejnov/netbird)"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_NAME}"
!define APP_PATH_KEY "Software\Microsoft\Windows\CurrentVersion\App Paths\Netbird"
!define UNINSTALLER "netbird_uninstall.exe"
; The installer is a 32-bit process; Sysnative reaches the native PowerShell.
!define POWERSHELL "$WINDIR\Sysnative\WindowsPowerShell\v1.0\powershell.exe"

Name "${APP_NAME}"
Caption "${DISPLAY_NAME} ${DISPLAY_VERSION}"
BrandingText "${DISPLAY_NAME} ${DISPLAY_VERSION}"
OutFile "${OUT_FILE}"
InstallDir "$PROGRAMFILES64\${APP_NAME}"
SetCompressor /SOLID lzma
ShowInstDetails show
ShowUninstDetails show

VIProductVersion "${VERSION}"
VIAddVersionKey "ProductName" "${DISPLAY_NAME}"
VIAddVersionKey "CompanyName" "${PUBLISHER}"
VIAddVersionKey "LegalCopyright" "NetBird Authors"
VIAddVersionKey "FileDescription" "${DISPLAY_NAME} installer"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${DISPLAY_VERSION}"

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "WinMessages.nsh"
!include "x64.nsh"

!define MUI_ICON "${ROOT_DIR}/client/ui/build/windows/icon.ico"
!define MUI_UNICON "${ROOT_DIR}/client/ui/build/windows/icon.ico"
!define MUI_ABORTWARNING

!insertmacro MUI_PAGE_LICENSE "${ROOT_DIR}/LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; Wintun loads only for the native architecture, so an amd64 package must not
; run under emulation on ARM64.
!macro RequireNativeArch
    !if "${ARCH}" == "arm64"
        ${IfNot} ${IsNativeARM64}
            MessageBox MB_ICONSTOP "This installer is for Windows on ARM64." /SD IDOK
            Abort
        ${EndIf}
    !else
        ${IfNot} ${IsNativeAMD64}
            MessageBox MB_ICONSTOP "This installer is for 64-bit Windows on x64." /SD IDOK
            Abort
        ${EndIf}
    !endif
!macroend

; Strips quotes and arguments from an UninstallString.
Function GetAppFromCommand
    Exch $1
    Push $2
    StrCpy $2 $1 1 0
    StrCmp $2 '"' 0 done
    Push $3
    StrCpy $3 ""
    loop:
        IntOp $3 $3 + 1
        StrCpy $2 $1 1 $3
        StrCmp $2 '' +2
        StrCmp $2 '"' 0 loop
        StrCpy $1 $1 $3
        StrCpy $1 $1 "" 1
    Pop $3
    done:
    Pop $2
    Exch $1
FunctionEnd

; Runs the uninstaller of an existing NetBird install, upstream or fork, in
; place and waits for it. Configuration in ProgramData is kept.
Function RemovePreviousInstall
    Exch $0
    Push $1
    Push $2
    Push $0
    Call GetAppFromCommand
    Pop $0
    GetFullPathName $1 "$0\.."
    ExecWait '"$0" /S _?=$1' $2
    ${If} $2 != 0
        MessageBox MB_ICONSTOP "Removing the installed NetBird failed (exit code $2)." /SD IDOK
        Abort
    ${EndIf}
    Delete "$0"
    RMDir "$1"
    Pop $2
    Pop $1
    Pop $0
FunctionEnd

Function .onInit
    !insertmacro RequireNativeArch
    SetRegView 64
    StrCpy $INSTDIR "$PROGRAMFILES64\${APP_NAME}"

    ; Upstream installers before 0.70.1 wrote the key to the 32-bit view.
    ReadRegStr $R0 HKLM "${UNINSTALL_KEY}" "UninstallString"
    ${If} $R0 == ""
        SetRegView 32
        ReadRegStr $R0 HKLM "${UNINSTALL_KEY}" "UninstallString"
        SetRegView 64
    ${EndIf}
    ${If} $R0 == ""
        Return
    ${EndIf}

    ${IfNot} ${Silent}
        MessageBox MB_YESNO|MB_ICONQUESTION "NetBird is already installed. It will be removed before ${DISPLAY_NAME} is installed; the configuration is kept. Proceed?" IDYES remove
        Abort
    ${EndIf}
    remove:
    Push $R0
    Call RemovePreviousInstall
FunctionEnd

Function un.onInit
    SetRegView 64
FunctionEnd

Section "Install"
    SetShellVarContext all
    SetRegView 64
    SetOutPath "$INSTDIR"
    File "${SRC_DIR}/netbird.exe"
    File "${SRC_DIR}/wintun.dll"
    WriteUninstaller "$INSTDIR\${UNINSTALLER}"

    WriteRegStr HKLM "${APP_PATH_KEY}" "" "$INSTDIR\netbird.exe"
    WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayName" "${DISPLAY_NAME}"
    WriteRegStr HKLM "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\${UNINSTALLER}"'
    WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\netbird.exe"
    WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayVersion" "${DISPLAY_VERSION}"
    WriteRegStr HKLM "${UNINSTALL_KEY}" "Publisher" "${PUBLISHER}"
    WriteRegStr HKLM "${UNINSTALL_KEY}" "URLInfoAbout" "https://github.com/ondrejnov/netbird"
    WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify" 1
    WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair" 1

    InitPluginsDir
    File "/oname=$PLUGINSDIR\path.ps1" "${SRC_DIR}/path.ps1"
    nsExec::ExecToLog '"${POWERSHELL}" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\path.ps1" -Action add -Dir "$INSTDIR"'
    Pop $0
    ${If} $0 != 0
        DetailPrint "Adding $INSTDIR to PATH failed: $0"
    ${EndIf}
    SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000

    DetailPrint "Installing the NetBird service..."
    nsExec::ExecToLog '"$INSTDIR\netbird.exe" service install'
    Pop $0
    ${If} $0 != 0
        DetailPrint "netbird service install failed: $0"
    ${EndIf}
    nsExec::ExecToLog '"$INSTDIR\netbird.exe" service start'
    Pop $0
    ${If} $0 != 0
        DetailPrint "netbird service start failed: $0"
    ${EndIf}
SectionEnd

Section "Uninstall"
    SetShellVarContext all
    SetRegView 64

    DetailPrint "Stopping the NetBird service..."
    nsExec::ExecToLog '"$INSTDIR\netbird.exe" service stop'
    Pop $0
    nsExec::ExecToLog '"$INSTDIR\netbird.exe" service uninstall'
    Pop $0
    ; The service manager releases the executable with a delay.
    Sleep 3000

    InitPluginsDir
    File "/oname=$PLUGINSDIR\path.ps1" "${SRC_DIR}/path.ps1"
    nsExec::ExecToLog '"${POWERSHELL}" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\path.ps1" -Action remove -Dir "$INSTDIR"'
    Pop $0
    SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000

    Delete "$INSTDIR\netbird.exe"
    Delete "$INSTDIR\wintun.dll"
    Delete "$INSTDIR\${UNINSTALLER}"
    RMDir "$INSTDIR"

    DeleteRegKey HKLM "${UNINSTALL_KEY}"
    DeleteRegKey HKLM "${APP_PATH_KEY}"
SectionEnd
