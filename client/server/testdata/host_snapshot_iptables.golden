family=2 table=254 dst=100.71.0.0/16 dev=wt0 type=1 scope=253
family=2 table=7120 dst=10.71.0.0/16 dev=wt0 type=1 scope=0
family=2 table=7120 dst=10.77.0.0/16 dev=wt0 type=1 scope=0
== rules ==
family=10 prio=0 table=255 mark=0 invert=false suppress=-1
family=10 prio=105 table=254 mark=0 invert=false suppress=0
family=10 prio=110 table=7120 mark=113920 invert=true suppress=-1
family=10 prio=32766 table=254 mark=0 invert=false suppress=-1
family=2 prio=0 table=255 mark=0 invert=false suppress=-1
family=2 prio=105 table=254 mark=0 invert=false suppress=0
family=2 prio=110 table=7120 mark=113920 invert=true suppress=-1
family=2 prio=32766 table=254 mark=0 invert=false suppress=-1
family=2 prio=32767 table=253 mark=0 invert=false suppress=-1
== sysctl ==
/proc/sys/net/ipv4/conf/all/rp_filter=2
/proc/sys/net/ipv4/conf/all/src_valid_mark=1
/proc/sys/net/ipv4/ip_forward=1
/proc/sys/net/netfilter/nf_conntrack_acct=0
