== iptables ==
iptables-save *filter -A FORWARD -i wt0 -j ACCEPT
iptables-save *filter -A FORWARD -o wt0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables-save *filter -A INPUT -i wt0 -j ACCEPT
iptables-save *filter :FORWARD ACCEPT 
iptables-save *filter :INPUT ACCEPT 
iptables-save *filter :OUTPUT ACCEPT 
== links ==
wt0 type=tuntap mtu=1280 addrs=[<overlay>/16]
